prefix=/workspace/opti2x/runs/stringtie-v3.0.3/benchmarks/harness/build-worktree/htslib/xlibs
exec_prefix=/workspace/opti2x/runs/stringtie-v3.0.3/benchmarks/harness/build-worktree/htslib/xlibs
libdir=/workspace/opti2x/runs/stringtie-v3.0.3/benchmarks/harness/build-worktree/htslib/xlibs/lib
includedir=/workspace/opti2x/runs/stringtie-v3.0.3/benchmarks/harness/build-worktree/htslib/xlibs/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.4.7
Cflags: -I${includedir}
Cflags.private: -DLZMA_API_STATIC
Libs: -L${libdir} -llzma
Libs.private: -pthread -lpthread
