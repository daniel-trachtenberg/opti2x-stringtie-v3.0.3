+ // H12: inline aux skip (no bam_aux_next/errno); early-exit once core tags seen.
+ // Core set used on every short-read hot path: NH, NM, XS|ts (HI/YK/YC/MD/ZS optional).
+ static inline uint8_t* aux_skip_inline(uint8_t* s, uint8_t* end) {
+   if (s >= end) return end;
+   int size;
+   switch (*s++) {
+     case 'A': case 'C': case 'c': size=1; break;
+     case 'S': case 's': size=2; break;
+     case 'I': case 'i': case 'f': size=4; break;
+     case 'd': size=8; break;
+     case 'Z': case 'H':
+       while (s < end && *s) ++s;
+       return s < end ? s + 1 : end;
+     case 'B': {
+       if (end - s < 5) return NULL;
+       int sz = 0;
+       switch (*s++) {
+         case 'C': case 'c': sz=1; break;
+         case 'S': case 's': sz=2; break;
+         case 'I': case 'i': case 'f': sz=4; break;
+         default: return NULL;
+       }
+       uint32_t n = (uint32_t)s[0] | ((uint32_t)s[1]<<8) | ((uint32_t)s[2]<<16) | ((uint32_t)s[3]<<24);
+       s += 4;
+       if (end - s < (long)(sz * n)) return NULL;
+       return s + sz * n;
+     }
+     default: return NULL;
+   }
+   if (end - s < size) return NULL;
+   return s + size;
+ }
+
+ void GSamRecord::ensure_aux_cache() {
+   if (auxc.ready) return;
+   invalidate_aux_cache();
+   auxc.ready=true;
+   if (b==NULL) return;
+   uint8_t* s = bam_get_aux(b);
+   uint8_t* end = b->data + b->l_data;
+   bool got_strand=false, got_NH=false, got_NM=false;
+   while (end - s >= 3) {
+     const char t0 = (char)s[0];
+     const char t1 = (char)s[1];
+     uint8_t* val = s + 2;
+     if (t0=='N' && t1=='H') { auxc.has_NH=true; auxc.NH=bam_aux2i(val); got_NH=true; }
+     else if (t0=='H' && t1=='I') { auxc.has_HI=true; auxc.HI=bam_aux2i(val); }
+     else if (t0=='N' && t1=='M') { auxc.has_NM=true; auxc.NM=bam_aux2i(val); got_NM=true; }
+     else if (t0=='n' && t1=='M') { auxc.has_nM=true; auxc.nM=bam_aux2i(val); }
+     else if (t0=='Y' && t1=='C') { auxc.has_YC=true; auxc.YC=bam_aux2i(val); }
+     else if (t0=='Y' && t1=='K') { auxc.has_YK=true; auxc.YK=bam_aux2f(val); }
+     else if (t0=='X' && t1=='S') {
+       char type=*val;
+       if (type=='A' || type=='Z') { auxc.has_XS=true; auxc.XS=*(char*)(val+1); got_strand=true; }
+     }
+     else if (t0=='t' && t1=='s') {
+       char type=*val;
+       if (type=='A' || type=='Z') { auxc.has_ts=true; auxc.ts=*(char*)(val+1); got_strand=true; }
+     }
+     else if (t0=='M' && t1=='D' && *val=='Z') { auxc.has_MD=true; auxc.MD=bam_aux2Z(val); }
+     else if (t0=='Z' && t1=='S' && *val=='Z') { auxc.has_ZS=true; auxc.ZS=bam_aux2Z(val); }
+     s = aux_skip_inline(val, end);
+     if (!s) break;
+   }
+   (void)got_strand; (void)got_NH; (void)got_NM;
+ }
 
