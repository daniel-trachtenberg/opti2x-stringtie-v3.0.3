+// Structured mate-pairing key (name + start + hi) with cached hash.
+// Matches former string key identity: name + '-' + start + '.=' + hi
+struct MateKey {
+	const char* name;
+	int start;
+	int hi;
+	uint64_t hash;
+};
+
+struct MateKeyHash {
+	uint64_t operator()(const MateKey& k) const { return k.hash; }
+};
+
+struct MateKeyEq {
+	bool operator()(const MateKey& a, const MateKey& b) const {
+		return a.start==b.start && a.hi==b.hi && strcmp(a.name, b.name)==0;
+	}
+};
+
+static inline uint64_t mate_key_hash(const char* name, int start, int hi) {
+	size_t len = strlen(name);
+	uint64_t h = wyhash(name, len, 0, _wyp);
+	uint64_t mix[2] = { (uint64_t)(uint32_t)start, (uint64_t)(uint32_t)hi };
+	return wyhash(mix, sizeof(mix), h, _wyp);
+}
+
+static inline MateKey make_mate_key(const char* name, int start, int hi) {
+	MateKey k;
+	k.name = name;
+	k.start = start;
+	k.hi = hi;
+	k.hash = mate_key_hash(name, start, hi);
+	return k;
+}
+
+class MateReadHash : public GHashMap<MateKey, int, MateKeyHash, MateKeyEq> {
+public:
+	MateReadHash(): GHashMap<MateKey, int, MateKeyHash, MateKeyEq>(false) {}
+
+	const int* FindMate(const char* name, int start, int hi) {
+		MateKey k = make_mate_key(name, start, hi);
+		return this->Find(k);
+	}
+
+	int AddMate(const char* name, int start, int hi, int val) {
+		MateKey k = make_mate_key(name, start, hi);
+		int absent = -1;
+		uint64_t i = this->put(k, &absent);
+		if (absent==1) {
+			this->key(i).name = Gstrdup(name);
+			this->value(i) = val;
+			return (int)i;
+		}
+		return -1;
+	}
+
+	int RemoveMate(const char* name, int start, int hi) {
+		MateKey k = make_mate_key(name, start, hi);
+		uint64_t i = this->get(k);
+		if (i != this->end()) {
+			char* s = (char*)this->key(i).name;
+			GFREE(s);
+			this->key(i).name = NULL;
+			this->del(i);
+			return (int)i;
+		}
+		return -1;
+	}
+
+	void Clear() {
+		uint64_t nb = this->n_buckets();
+		for (uint64_t i = 0; i != nb; ++i) {
+			if (!this->_used(i)) continue;
+			char* s = (char*)this->key(i).name;
+			GFREE(s);
+			this->key(i).name = NULL;
+		}
+		this->clear();
+	}
+
+	~MateReadHash() { Clear(); }
+};
